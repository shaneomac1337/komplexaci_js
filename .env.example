# Riot Games API Configuration
# Get your API key from: https://developer.riotgames.com/
# Development keys expire every 24 hours
# For production, apply for a Personal or Production API key
RIOT_API_KEY=RGAPI-your-api-key-here

# Discord API Configuration
# To get these values:
# 1. Go to https://discord.com/developers/applications
# 2. Create a new application or select existing one
# 3. Go to "Bot" section and copy the token
# 4. Get your server ID by right-clicking your Discord server and selecting "Copy Server ID"
#    (You need to enable Developer Mode in Discord settings first)

DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_SERVER_ID=your_discord_server_id_here

# Enable real-time Discord Gateway (WebSocket) for instant presence updates
# Set to 'true' to enable real-time member status (requires bot intents)
# Set to 'false' to use REST API polling (default)
ENABLE_DISCORD_GATEWAY=true

# Optional: comma-separated Discord channel IDs to display in the homepage preview.
# Order is preserved. Channels not present on the configured guild are skipped silently.
# If unset, the gateway auto-picks the first 3 text channels + the first voice channel
# (sorted by Discord position).
DISCORD_PREVIEW_CHANNEL_IDS=

# Next.js Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-here

# Discord OAuth (required for admin login via NextAuth)
# From the same Discord application: OAuth2 -> Client ID / Client Secret
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret

# Supabase (admin profile / role storage; required for admin features)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Optional - analytics SQLite directory (defaults to ./data)
ANALYTICS_DATA_DIR=

# Optional - verbose Riot API request logging
RIOT_API_DEBUG=